    <!-- JAVASCRIPT LÓGICA INTERACTIVA -->
    <script>
        // Data Hero Slider
        const heroFlavors = [
            {
                tag: 'Manzanilla',
                tagBg: 'bg-amber-100 text-amber-900',
                title: 'Sabor Manzanilla',
                desc: 'Suave infusión calmante de flor de manzanilla triturada sobre avena crocante.',
                iconClass: 'fa-spa',
                iconColor: 'bg-amber-100 border-amber-300 text-amber-600'
            },
            {
                tag: 'Menta',
                tagBg: 'bg-emerald-100 text-emerald-900',
                title: 'Sabor Menta Fresca',
                desc: 'Frescura vibrante que estimula el sentido con hojas de menta digestiva.',
                iconClass: 'fa-leaf',
                iconColor: 'bg-emerald-100 border-emerald-300 text-emerald-600'
            },
            {
                tag: 'Cedrón',
                tagBg: 'bg-lime-100 text-lime-900',
                title: 'Sabor Cedrón Citriodora',
                desc: 'Toque ahumado cítrico ideal para la digestión estomacal liviana.',
                iconClass: 'fa-lemon',
                iconColor: 'bg-lime-100 border-lime-300 text-lime-600'
            }
        ];

        let currentHeroIndex = 0;

        function setHeroFlavor(index) {
            currentHeroIndex = index;
            const data = heroFlavors[index];
            
            document.getElementById('hero-flavor-tag').innerText = data.tag;
            document.getElementById('hero-flavor-tag').className = `px-3 py-1 rounded-full text-xs font-bold uppercase ${data.tagBg}`;
            
            document.getElementById('hero-flavor-title').innerText = data.title;
            document.getElementById('hero-flavor-desc').innerText = data.desc;

            const iconContainer = document.getElementById('hero-cookie-icon');
            iconContainer.className = `w-40 h-40 mx-auto rounded-full border-4 flex items-center justify-center shadow-inner transform transition-all duration-500 hover:rotate-12 ${data.iconColor}`;
            iconContainer.innerHTML = `<i class="fa-solid ${data.iconClass} text-6xl"></i>`;

            // Dots Update
            const dots = document.querySelectorAll('.hero-dot');
            dots.forEach((dot, idx) => {
                if (idx === index) {
                    dot.className = 'hero-dot w-3 h-3 rounded-full bg-brand-rose transition-all';
                } else {
                    dot.className = 'hero-dot w-3 h-3 rounded-full bg-gray-300 transition-all';
                }
            });
        }

        // Auto slide hero
        setInterval(() => {
            currentHeroIndex = (currentHeroIndex + 1) % heroFlavors.length;
            setHeroFlavor(currentHeroIndex);
        }, 5000);

        // Mobile Menu Toggle
        const menuBtn = document.getElementById('menu-btn');
        const closeMenuBtn = document.getElementById('close-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.remove('translate-x-full');
        });

        closeMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.add('translate-x-full');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('translate-x-full');
            });
        });

        // WhatsApp Order Helper
        function orderWhatsApp(flavor) {
            const text = encodeURIComponent(`¡Hola AVENOVA! Quisiera realizar un pedido de Galletas de Avenova sabor ${flavor}. ¿Me indican los detalles de entrega?`);
            window.open(`https://wa.me/59170000000?text=${text}`, '_blank');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            const text = encodeURIComponent(`¡Hola AVENOVA! Envié una consulta desde la página web para ponerme en contacto.`);
            window.open(`https://wa.me/59170000000?text=${text}`, '_blank');
        }
    </script>
